{
    "name": "ONC Informatica",

    "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",

    "containerEnv": {
        "TZ": "Europe/Amsterdam",
        "VIRTUAL_ENV_DISABLE_PROMPT": "1"
    },

    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "2.99.0"
        }
    },

    "customizations": {
        "codespaces": {
            "repositories": {
                "oncparkdreef/*": {
                    "permissions": {
                        "contents": "write"
                    }
                }
            }
        },

        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-python.vscode-python-envs",
                "ms-toolsai.jupyter"
            ]
        }
    },

    "postCreateCommand": "bash scripts/setup-student.sh",
    "postAttachCommand": "bash scripts/open-student.sh"
}


